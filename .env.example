# Backend security
JWT_SECRET=replace-with-a-long-random-secret

# Mail integration
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# AWS placeholders (only required when real S3 integration is enabled)
AWS_ACCESS_KEY=your-access-key
AWS_SECRET_KEY=your-secret-key

# Razorpay test credentials
RAZORPAY_KEY_ID=rzp_test_local
RAZORPAY_KEY_SECRET=local_secret
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_DEMO=false

# Enable delivery once an SMTP server is configured
TICKET_MAIL_ENABLED=false
TICKET_MAIL_FROM=no-reply@eventflow.local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Development-only staff sign-up. Keep disabled on shared deployments.
APP_AUTH_ALLOW_ROLE_REGISTRATION=false

# Frontend origin
APP_FRONTEND_URL=http://localhost:3000
